    "type": [
      "object",
      "null"
    ],
    "properties": {
      "pathway_uuid": {
        "type": [
          "string",
          "null"
        ]
      },
      "patent_id": {
        "type": "string"
      },
      "scope": {
        "type": [
          "string",
          "null"
