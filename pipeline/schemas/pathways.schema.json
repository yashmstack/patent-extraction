            "type": [
              "string",
              "null"
            ]
          },
          "smiles_source": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^((patent_scheme|curated|patent_drawing|opsin|pubchem)(\\+(patent_scheme|curated|patent_drawing|opsin|pubchem))*|none:(markush|reference|class_name|material|polymer|ambiguous|unresolved)|joined_from_participants)$"
